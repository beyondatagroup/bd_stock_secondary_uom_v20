<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_stock_quant_tree_secondary_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.secondary.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='uom_id']" position="after">

                <field name="secondary_qty"
                       string="Secondary Qty" optional="show"
                       readonly="1" groups="bd_stock_secondary_uom.group_inventory_secondary"/>

                <field name="secondary_uom_id"
                       string="Secondary UoM" optional="show"
                       readonly="1" groups="bd_stock_secondary_uom.group_inventory_secondary"/>

            </xpath>

        </field>
    </record>

    <record id="view_stock_quant_tree_editable_secondary_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.secondary.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='uom_id']" position="after">

                <field name="secondary_qty"
                       string="Secondary Qty"
                       optional="show"
                       readonly="1"
                       groups="bd_stock_secondary_uom.group_inventory_secondary"/>

                <field name="secondary_uom_id"
                       string="Secondary UoM"
                       optional="show"
                       readonly="1"
                       groups="bd_stock_secondary_uom.group_inventory_secondary"/>

            </xpath>

        </field>
    </record>

</odoo>
